l*!8f,^-Dzt"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(ControllerButtonEvent.Pressed, function mostrar_inventari() {" line1="        let estado: any;" line2="        let texto = &quot;MOCHILA:\n&quot;" line3="        for (let j of items) {" line4="            if (j.tipo == &quot;mision&quot;) {" line5="                estado = j.recogido ? &quot;[X] &quot; : &quot;[ ] &quot;" line6="                texto += estado + j.nombre + &quot;\n&quot;" line7="            }" line8="            " line9="        }" line10="        game.showLongText(texto, DialogLayout.Full)" line11="    })" numlines="12"></mutation><next><block type="variables_set" id="aaNz1-v-R=KEZNpn~3sN"><field name="VAR" id="[@|.OH}mnp9$5dHoroN|">items</field><value name="VALUE"><shadow type="math_number" id="-pjpOwjy~7la1m)E%94l"><field name="NUM">0</field></shadow><block type="lists_create_with" id="|7|nrm#DXqaaff$`,,/*"><mutation items="0" horizontalafter="3"></mutation></block></value><next><block type="variables_set" id="P@6Y}ofmel`IP*|^jbZh"><field name="VAR" id="nkN7h*@YU|xkg?B6_IfB">nivel_actual</field><value name="VALUE"><shadow type="math_number" id="jVB%Xd32Zx`~?kP*ut=W"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="+hg0CeXxX{ZDlt#h-@b5"><field name="VAR" id="Bc#+/4TFxGX)`mj^3FzF">energia</field><value name="VALUE"><shadow type="math_number" id="-Pwsm$4Qhnj2/h[@buRv"><field name="NUM">100</field></shadow></value><next><block type="function_call" id="Wmi?0Zu;!k;JMxc(bIk?"><mutation name="generar_mundo" functionid="sVH,O(32%74^+U!/X#g_"></mutation><next><block type="variables_set" id="0u{xtokf/T@RAm{})HO*"><field name="VAR" id="2Q,jsA(QQlT^7`q$bKL]">juego_activo</field><value name="VALUE"><shadow type="math_number" id="Tn)CSWG`+~`Of8Lx9iTo"><field name="NUM">0</field></shadow><block type="logic_boolean" id="/9wue.kSm0s)l*=TE7[h"><field name="BOOL">TRUE</field></block></value><next><block type="game_show_long_text" id="U0M$cfJU[))X3