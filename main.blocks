perderas TODOS los objetos.`</field></block></value><next><block type="function_call" id=",{ms=)xv)nOu]=3s:ueq"><mutation name="setup_hero" functionid="|D9;W4+TJ2d=YAj;NQ[T"></mutation><next><block type="typescript_statement" id="#W#@FY|!FU9s@FYO(xH("><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(ControllerButtonEvent.Pressed, function mostrar_inventari() {" line1="        let texto = &quot;MOCHILA:\n&quot;" line2="        let encontrados = 0" line3="        for (let j of items) {" line4="            if (j.tipo == &quot;mision&quot; &amp;&amp; j.recogido) {" line5="                texto += &quot;[X] &quot; + j.nombre + &quot;\n&quot;" line6="                encontrados += 1" line7="            }" line8="            " line9="        }" line10="        if (encontrados == 0) {" line11="            texto += &quot;(Vacia)&quot;" line12="        }" line13="        " line14="        game.showLongText(texto, DialogLayout.Full)" line15="    })" numlines="16"></mutation><next><block type="variables_set" id="?NHhj3}9TcSl2Ll+M=(}"><field name="VAR" id="z;p)1p5%{EN6U=o7gGDR">items</field><comment pinned="false" h="80" w="160">Inicialización limpia</comment><value name="VALUE"><shadow type="math_number" id="E,b]^7+;QS#[|;yl]9R."><field name="NUM">0</field></shadow><block type="lists_create_with" id="1!~pmFQ)u0rMyyCye`L["><mutation items="0" horizontalafter="3"></mutation></block></value><next><block type="variables_set" id=".EF7n^Yw:lw+dGvsA|x;"><field name="VAR" id="I9]Ai2=kOHBy~VZiS:S1">nivel_actual</field><value name="VALUE"><shadow type="math_number" id="rhlxfHa,hBI106v]OO7z"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="qcA2l^H1!7berq3Wm|kV"><field name="VAR" id="$]~?.m=lH$~+Hq^C%fr7">energia</field><comment pinned="false" h="80" w="160">VIDA INICIAL 999</comment><value name="VALUE"><shadow type="math_number" id="%QFikG.{|Hxn-4im^AO%"><field name="NUM">999</field></shadow></value><next><block type="function_cal