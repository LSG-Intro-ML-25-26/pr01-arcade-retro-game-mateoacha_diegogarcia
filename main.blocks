perderas TODOS los objetos.`</field></block></value><next><block type="function_call" id="_#L5*0Vt3t`V#U6Mr[ly"><mutation name="setup_hero" functionid="%aLzh|(:*A%:96WrJeH="></mutation><next><block type="typescript_statement" id="iTW-,|D-jPjGu2.VrcRW"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="controller.B.onEvent(ControllerButtonEvent.Pressed, function mostrar_inventari() {" line1="        let texto = &quot;MOCHILA:\n&quot;" line2="        let encontrados = 0" line3="        for (let k of items) {" line4="            if (k.tipo == &quot;mision&quot; &amp;&amp; k.recogido) {" line5="                texto += &quot;[X] &quot; + k.nombre + &quot;\n&quot;" line6="                encontrados += 1" line7="            }" line8="            " line9="        }" line10="        if (encontrados == 0) {" line11="            texto += &quot;(Vacia)&quot;" line12="        }" line13="        " line14="        game.showLongText(texto, DialogLayout.Full)" line15="    })" numlines="16"></mutation><next><block type="variables_set" id="R@1b7TQ8fnkdCpY[6lwl"><field name="VAR" id="^pPxrJ7h~8:PG2iEJIrC">items</field><value name="VALUE"><shadow type="math_number" id="g7Eum8UjVq[!}?=CW-U*"><field name="NUM">0</field></shadow><block type="lists_create_with" id="]xQq4JA*-Ic_FK+F|x|_"><mutation items="0" horizontalafter="3"></mutation></block></value><next><block type="variables_set" id="x9EDI^3;mK,iwV=!hXz{"><field name="VAR" id=":Y{I^wvplZ@507SW8W2_">nivel_actual</field><value name="VALUE"><shadow type="math_number" id="R$fAGuX7tTcM.,`a;R]f"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="g*?iEV;O7c/0!H.trjLh"><field name="VAR" id="7[v,kNY)80OCJW5w:JDD">energia</field><value name="VALUE"><shadow type="math_number" id="0_ds~LVGIgCEry7KyHcJ"><field name="NUM">100</field></shadow></value><next><block type="function_call" id="8U^R$Hx@I;cUfF5xhG_E"><mutation name="generar_mundo" functionid="|i9/uRN_EqhlKa%JhC$`"></mutation><next><block type="variables_s